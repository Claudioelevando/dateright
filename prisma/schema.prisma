generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// id casa com o id do usuário em auth.users (Supabase Auth).
// O FK real para auth.users é criado via SQL em migration (Prisma não gerencia o schema `auth`).
model Profile {
  id                    String    @id @db.Uuid
  email                 String    @unique
  name                  String
  birthDate             DateTime  @db.Date
  city                  String
  latitude              Float?
  longitude             Float?
  bio                   String?
  gender                Gender
  interestedIn          InterestedIn
  ageRangeMin           Int       @default(18)
  ageRangeMax           Int       @default(99)
  maxDistanceKm         Int       @default(50)
  onboardingCompletedAt DateTime?
  isPremium             Boolean   @default(false)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  role                  Role      @default(USER)
  suspendedAt           DateTime?
  suspendedReason       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  photos    ProfilePhoto[]
  interests ProfileInterest[]
  answers   QuestionnaireAnswer[]

  swipesGiven    Swipe[] @relation("SwipesGiven")
  swipesReceived Swipe[] @relation("SwipesReceived")
  matchesAsA     Match[] @relation("MatchesAsA")
  matchesAsB     Match[] @relation("MatchesAsB")
  messagesSent   Message[] @relation("MessagesSent")

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")
  reportsReviewed Report[] @relation("ReportsReviewed")
  blocksGiven     Block[]  @relation("BlocksGiven")
  blocksReceived  Block[]  @relation("BlocksReceived")

  @@map("profiles")
}

enum Gender {
  MASCULINO
  FEMININO
}

enum InterestedIn {
  MASCULINO
  FEMININO
  AMBOS
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model ProfilePhoto {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  storagePath String // caminho no bucket do Supabase Storage
  position  Int // 0 = capa
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, position])
  @@map("profile_photos")
}

model Interest {
  id    String @id @default(uuid()) @db.Uuid
  slug  String @unique
  label String
  order Int    @default(0)

  profiles ProfileInterest[]

  @@map("interests")
}

model ProfileInterest {
  profileId  String @db.Uuid
  interestId String @db.Uuid

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@map("profile_interests")
}

enum QuestionType {
  SINGLE
  MULTIPLE
  SCALE
}

model QuestionnaireQuestion {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique // slug estável, ex: "relacionamento-compromisso"
  category      String
  type          QuestionType
  text          String
  options       Json? // string[] — apenas single/multiple
  minSelections Int? // apenas multiple
  minLabel      String? // apenas scale
  maxLabel      String? // apenas scale
  order         Int
  active        Boolean      @default(true)

  answers QuestionnaireAnswer[]

  @@map("questionnaire_questions")
}

model QuestionnaireAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @db.Uuid
  questionId String   @db.Uuid
  value      Json // string | string[] | number
  answeredAt DateTime @default(now())

  profile  Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  question QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([profileId, questionId])
  @@map("questionnaire_answers")
}

enum SwipeAction {
  LIKE
  PASS
}

model Swipe {
  id        String      @id @default(uuid()) @db.Uuid
  swiperId  String      @db.Uuid
  swipedId  String      @db.Uuid
  action    SwipeAction
  createdAt DateTime    @default(now())

  swiper Profile @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped Profile @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swipedId])
  @@map("swipes")
}

// userAId < userBId sempre (canonicalizado em código) — evita linhas duplicadas para o
// mesmo par em ordens diferentes; reforçado por CHECK na migration.
model Match {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @db.Uuid
  userBId   String   @db.Uuid
  createdAt DateTime @default(now())

  userA Profile @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB Profile @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("matches")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  senderId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender Profile @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  // Sem readAt: confirmação de leitura fica para um milestone futuro.
  @@index([matchId, createdAt])
  @@map("messages")
}

enum ReportReason {
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SCAM
  MINOR
  OTHER
}

enum ReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedId     String       @db.Uuid
  reason         ReportReason
  details        String?
  status         ReportStatus @default(PENDING)
  reviewedById   String?      @db.Uuid
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())

  reporter   Profile  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   Profile  @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reviewedBy Profile? @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId])
  @@map("reports")
}

// blockerId "não vê mais" blockedId (descoberta/match/chat) — unidirecional por natureza,
// mas assertParticipant/discover checam nos dois sentidos: quem bloqueou não deve ver quem
// foi bloqueado, e vice-versa.
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker Profile @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}
